# Copy this file to .env.local, then fill in what you need. Every line is optional.

# Apify, only used when TikTok shows a puzzle to robots: the app then reads the TikTok profile through Apify.
# Get your token at https://console.apify.com/settings/integrations
APIFY_API_KEY=

# Your name, the way the report should say it ("Weekly review with ..."). Empty = "the consultant".
CONSULTANT_NAME=

# The full path to the Claude Code app, only if the app can't find it by itself.
CLAUDE_BIN=

# Time zone for dates and for the browser that opens the pages. Default: Asia/Kuala_Lumpur.
APP_TIMEZONE=
